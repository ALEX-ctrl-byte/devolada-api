# Copia este archivo como .env y ajusta los valores. .env NO se sube a Git.
PORT=3000
# Dominio HTTPS de la API cuando se publican imágenes del negocio (sin barra final).
# Si usas un túnel Quick Tunnel, actualízalo cuando Cloudflare cambie de URL.
PUBLIC_API_URL=
NODE_ENV=development
# Detrás de Railway / Cloudflare / DigitalOcean: TRUST_PROXY=true (en local basta el valor por defecto: loopback)
TRUST_PROXY=true
# Orígenes web permitidos (panel). Lista separada por comas.
CORS_ORIGIN=https://panel.usadevolada.com
FRONTEND_URL=https://panel.usadevolada.com
ADMIN_WEB_ORIGIN=http://localhost:5173  # En producción, reemplaza por el origen HTTPS real del panel

# Opción A (Railway / DigitalOcean): DATABASE_URL tiene prioridad sobre DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD.
#   Railway (red privada, sin TLS):  DATABASE_URL=${{MySQL.MYSQL_URL}}   (se escribe así en el panel de Railway)
#   DigitalOcean: mysql://usuario:clave@host:25060/devolada?ssl-mode=REQUIRED
DATABASE_URL=
# TLS hacia MySQL. En Railway (red privada) NO se define. En DigitalOcean Managed MySQL: true.
# DB_CA_CERT (opcional) = certificado CA para verificar el servidor.
DB_SSL=
DB_CA_CERT=
# Opción B (local): variables sueltas. Nombre de base por defecto: devolada.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=devolada
# Solo desarrollo local. En producción crea un usuario MySQL dedicado, con privilegios mínimos.
DB_USER=root
DB_PASSWORD=

# Etapa 4 (opcional en desarrollo; OBLIGATORIO en producción)
OTP_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
# El login de la app es teléfono + PIN (POST /entrar); el OTP ya no se usa en el flujo normal.
# consola = solo desarrollo local; desactivado = sin OTP (recomendado en producción, sin costo);
# whatsapp = WhatsApp Cloud API real (solo si algún día se vuelve a usar OTP)
OTP_PROVEEDOR=desactivado
# Para WhatsApp real, cambia OTP_PROVEEDOR=whatsapp y completa estas variables:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=deuna_otp
WHATSAPP_OTP_LANGUAGE=es
WHATSAPP_GRAPH_VERSION=v22.0

# Versión de los términos y condiciones vigentes (se registra por usuario al aceptar)
VERSION_TERMINOS=1.0

# Stadia Maps: geocodificación y rutas (Valhalla), solo desde el backend.
STADIA_MAPS_API_KEY=PEGA_AQUI_TU_CLAVE_STADIA
STADIA_ROUTING_URL=https://api.stadiamaps.com/route/v1

# URL HTTPS de la imagen directa del QR oficial o una página compartida de imgbb (ibb.co). No es un QR dinámico.
QR_RECARGA_DEUNA_URL=

# OSRM: cálculo de rutas por calles (viajes, pedidos y envíos). Gratis; en producción conviene un servidor propio.
OSRM_BASE_URL=https://router.project-osrm.org

# Número de WhatsApp del administrador que recibe las solicitudes de activación de cuenta.
# Solo dígitos con código de país, sin + ni espacios.
WHATSAPP_BUSINESS_NUMBER=591XXXXXXXXX

# Puntos fijos que se descuentan por cada viaje, pedido o envío completado (1 Bs recargado = 1 punto).
PUNTOS_POR_VIAJE=2

# --- Almacenamiento de archivos (documentos de conductores e imágenes de comercios) ---
# disco = carpetas locales (desarrollo, o Railway con un Volume montado, p. ej. en /data).
# s3    = DigitalOcean Spaces (o cualquier S3 compatible). Sin Volume, el disco de Railway se borra en cada despliegue.
# Con un Volume de Railway la API usa automáticamente ${RAILWAY_VOLUME_MOUNT_PATH}/documentos y /comercios.
ALMACENAMIENTO_DRIVER=disco
# Solo si ALMACENAMIENTO_DRIVER=s3. El bucket debe ser PRIVADO; la API es la única que lo lee.
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com   (sin barra final y sin el nombre del bucket)
# SPACES_REGION=nyc3
# SPACES_BUCKET=devolada-archivos
# SPACES_KEY=
# SPACES_SECRET=
